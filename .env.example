# Copy to .env and adjust as needed.
# Defaults below match docker-compose service hostnames + DECISIONS.md timings.
#
# For a fast Phase 4 manual demo, use shorter values (see comments at bottom).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mcareers

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/mcareers
REDIS_URL=redis://redis:6379/0

WORKER_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=30

EMAIL_MOCK_SLEEP_SECONDS=0.5
WEBHOOK_MOCK_SLEEP_SECONDS=0.3
REPORT_MOCK_SLEEP_SECONDS=1.0
BATCH_ITEM_SLEEP_SECONDS=0.05

RETRY_BACKOFF_AFTER_ATTEMPT_1_SECONDS=30
RETRY_BACKOFF_AFTER_ATTEMPT_2_SECONDS=120
DEFAULT_MAX_ATTEMPTS=3

REAPER_POLL_INTERVAL_SECONDS=5.0
EXECUTOR_POLL_INTERVAL_SECONDS=0.5
SCHEDULER_POLL_INTERVAL_SECONDS=1.0

# --- Optional Phase 4 demo profile (copy into .env, then recreate services) ---
# WORKER_LEASE_SECONDS=30
# JOB_TIMEOUT_SECONDS=5
# EMAIL_MOCK_SLEEP_SECONDS=0.2
# WEBHOOK_MOCK_SLEEP_SECONDS=0.2
# REPORT_MOCK_SLEEP_SECONDS=8
# BATCH_ITEM_SLEEP_SECONDS=0.4
# RETRY_BACKOFF_AFTER_ATTEMPT_1_SECONDS=2
# RETRY_BACKOFF_AFTER_ATTEMPT_2_SECONDS=3
# REAPER_POLL_INTERVAL_SECONDS=2
# EXECUTOR_POLL_INTERVAL_SECONDS=0.2
# SCHEDULER_POLL_INTERVAL_SECONDS=0.5
